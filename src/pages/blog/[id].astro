---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import SiteLayout from "../../portfolio/SiteLayout.astro";
import "../../portfolio/article.css";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, date, category, cover } = entry.data;
const { Content, headings } = await render(entry);
const sections = headings.filter(({ depth }) => depth === 2);
---
<SiteLayout title={`${title} · 星音`} description={`${title}，星音的${category}。`} current="blog">
  <article class="reading-column">
    <header class="article-header">
      <a class="text-link" href={`${import.meta.env.BASE_URL}blog/`}><span aria-hidden="true">←</span> 所有文章</a>
      <h1>{title}</h1>
      <p><time datetime={date}>{date}</time><span>{category}</span></p>
    </header>
    {cover && <Image class="article-cover" src={cover} alt="" />}
    {sections.length > 2 && (
      <details class="article-toc">
        <summary>本文目录</summary>
        <ul>{sections.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}</ul>
      </details>
    )}
    <div class="article-body"><Content /></div>
  </article>
</SiteLayout>
