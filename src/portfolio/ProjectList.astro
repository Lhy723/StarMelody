---
import { ArrowUpRight } from "lucide-react";
import { featuredProjects } from "./content.js";
---
<ul class="featured-list">
  {featuredProjects.map(({ name, summary, category, url }) => (
    <li>
      <a class="featured-project" href={url}>
        <h3>{name}</h3>
        <p>{summary}</p>
        <span class="project-category">{category}</span>
        <ArrowUpRight className="link-icon" size={19} strokeWidth={1.6} aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>
