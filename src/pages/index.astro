---
import { ArrowRight } from "lucide-react";
import Portrait from "../portfolio/Portrait.astro";
import PostList from "../portfolio/PostList.astro";
import ProjectList from "../portfolio/ProjectList.astro";
import SiteLayout from "../portfolio/SiteLayout.astro";
import { repositories } from "../portfolio/content.js";

const base = import.meta.env.BASE_URL;
---
<SiteLayout title="星音 · 开发者主页" description="星音的开发者主页，收录开源项目、开发笔记与原创角色 StarMelody。" current="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">星音</h1>
      <p class="hero-description">开源项目、技术笔记与原创角色。</p>
      <div class="hero-links">
        <a class="primary-link" data-astro-prefetch href={`${base}projects/`}>浏览项目 <ArrowRight className="link-icon" size={16} strokeWidth={1.7} aria-hidden="true" /></a>
        <a class="text-link" data-astro-prefetch href={`${base}blog/`}>阅读博客 <ArrowRight className="link-icon" size={16} strokeWidth={1.7} aria-hidden="true" /></a>
      </div>
    </div>
    <Portrait />
  </section>
  <section class="content-section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">精选项目</h2>
      <a class="text-link" data-astro-prefetch href={`${base}projects/`}>全部 {repositories.length} 个仓库 <ArrowRight className="link-icon" size={16} strokeWidth={1.7} aria-hidden="true" /></a>
    </div>
    <ProjectList />
  </section>
  <section class="content-section" id="writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">精选文章</h2>
      <a class="text-link" data-astro-prefetch href={`${base}blog/`}>博客目录 <ArrowRight className="link-icon" size={16} strokeWidth={1.7} aria-hidden="true" /></a>
    </div>
    <PostList limit={2} />
  </section>
</SiteLayout>
